#!name = Custom Video App AdBlock
#!desc = 精准路径拦截与空响应劫持
#!author = Custom

[Rule]
DOMAIN-KEYWORD, kanshipin, REJECT
DOMAIN-KEYWORD, sdapi, REJECT

[Rewrite]
# 1. 针对所有动态域名下的广告路径进行拦截，并直接伪造 200 状态码返回空内容
^https?:\/\/(?:[a-z0-9-]+\.)+[a-z]+\/App\/[Aa]d\/.* - reject_dict(200)
^https?:\/\/(?:[a-z0-9-]+\.)+[a-z]+\/App\/IndexList\/homeFloatAd - reject_dict(200)
^https?:\/\/(?:[a-z0-9-]+\.)+[a-z]+\/App\/Resource\/CommentAd - reject_dict(200)

[MITM]
# 2. 精准解密刚才抓包中出现过的后端域名，确保重写路径能生效
hostname = *.xqe4cxu.com, *.syq8gvw.com, *.zjypp7x.com, *.wtwvm3.com, *.jjawa.com, *.emw5es6.com
