#!name = 恒时观瓜子影视 App 去广告
#!desc = 精准放行 /upload/vod/ 剧集海报，定向拦截 /upload/ita/ 广告图与广告接口
#!author = Custom

[Rule]
# 1. 仅拦截纯广告第三方域名（绝不封杀 jjawa.com 和 cj-images，否则必裂图！）
DOMAIN-SUFFIX, 4mqczu3.com, REJECT
DOMAIN-SUFFIX, hzpabxw.com, REJECT
DOMAIN-SUFFIX, 67c6c7a.com, REJECT
DOMAIN-SUFFIX, 7utqqyh.com, REJECT
DOMAIN-SUFFIX, d8evzth.live, REJECT
DOMAIN-KEYWORD, kanshipin, REJECT
DOMAIN-KEYWORD, sdapi, REJECT
DOMAIN-KEYWORD, 918api, REJECT
DOMAIN-KEYWORD, haiwaiapi, REJECT

# 2. 精准拦截 cj-images 图床下的 /upload/ita/ 广告图片目录（同时保护 /upload/vod/ 电视剧海报）
URL-REGEX, ^https?:\/\/cj-images\.[a-z0-9-]+\.[a-z]+\/upload\/ita\/, REJECT

[Rewrite]
# 3. 路径级精细去广告（严格加上 \/ 边界，彻底杜绝 ads? 误伤 /upload/vod/ 正片封面）
^https?:\/\/(?:[a-z0-9-]+\.)+[a-z]+\/App\/([Aa]d\/.*|[Ii]ndexList\/homeFloatAd|[Rr]esource\/CommentAd|.*(pauseAd|floatAd|popAd|bannerAd).*)$ reject-dict
^https?:\/\/(?:[a-z0-9-]+\.)+[a-z]+\/(?:.*\/)?(splash|ads?|startup|initAd|getAd|adList)(\/|\?|$).*$ reject-dict

[MITM]
# 4. 仅解密图床与主 API 域名以供 URL-REGEX 和 Rewrite 生效
hostname = cj-images.jjawa.com, *.f97568.com, *.hzpabxw.com, *.4mqczu3.com
