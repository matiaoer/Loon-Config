[Name]
Custom Video App AdBlock

[Description]
Author = Custom
Description = 强力全域名正则封锁动态后端

[Rule]
# 1. 绝对阻断所有包含 918api, haiwaiapi, tkfupxqu 的域名
DOMAIN-KEYWORD, 918api, REJECT
DOMAIN-KEYWORD, haiwaiapi, REJECT
DOMAIN-KEYWORD, tkfupxqu, REJECT
DOMAIN-KEYWORD, 5h5hbfhh, REJECT
DOMAIN-KEYWORD, kanshipin, REJECT
DOMAIN-KEYWORD, sdapi, REJECT

[Rewrite]
# 2. 强力 URL 重写拦截（只要网址里带这些特征直接拒绝）
^https?:\/\/.*(918api|haiwaiapi|tkfupxqu|5h5hbfhh|kanshipin|sdapi).*$ - REJECT

# 3. 正则通杀所有 8 位随机字母的 api 域名
^https?:\/\/api\.[a-z]{8}\.com\/ - REJECT

# 4. 拦截常见广告路径
^https?:\/\/.*\/.*(splash|ad|startup|banner|notice).*$ - REJECT

[Script]
http-response ^https?:\/\/(.*(918api|haiwaiapi|tkfupxqu|5h5hbfhh|sdapi|kanshipin).*|api\.[a-z]{8}\.com)\/.* script-path=https://raw.githubusercontent.com/matiaoer/Loon-Config/refs/heads/main/adclean.js,requires-body=true,max-size=0,tag=App去广告净化
