#!name = Custom Video App AdBlock
#!desc = 精准解密与动态泛正则拦截
#!author = Custom

[Rule]
# 1. 核心关键词全局强杀
DOMAIN-KEYWORD, kanshipin, REJECT
DOMAIN-KEYWORD, sdapi, REJECT
DOMAIN-KEYWORD, 918api, REJECT
DOMAIN-KEYWORD, haiwaiapi, REJECT

[Rewrite]
# 2. 核心大招：无条件通杀所有 api.xxxxxx.com (8位随机小写字母) 的动态后端
^https?:\/\/api\.[a-z]{8}\.com\/ - reject

# 3. 拦截常见广告路径
^https?:\/\/.*\/.*(splash|ad|startup|banner|notice).*$ - reject

[Script]
http-response ^https?:\/\/api\.[a-z]{8}\.com\/.* script-path=https://raw.githubusercontent.com/matiaoer/Loon-Config/refs/heads/main/adclean.js,requires-body=true,max-size=0,tag=动态去广告净化

[MITM]
# 4. 只精准解密这几类动态广告和 API 域名，绝对不碰 *.com，保障 Gemini 完美运行！
hostname = *.xqe4cxu.com, *.syq8gvw.com, *.zjypp7x.com, *.wtwvm3.com, *.jjawa.com, *.emw5es6.com, *.tkfupxqu.com, *.5h5hbfhh.com
