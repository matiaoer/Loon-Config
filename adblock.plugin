[Name]
Custom Video App AdBlock

[Description]
Author = Custom
Description = 结合 JS 脚本精准清洗开屏广告

[Rule]
DOMAIN-KEYWORD, kanshipin, REJECT
DOMAIN-KEYWORD, sdapi, REJECT

[Rewrite]
^https?:\/\/.*\/.*(splash|ad|startup|banner).*$ - REJECT

[Script]
# 使用你刚刚生成的 adclean.js 直链进行动态清洗
http-response ^https?:\/\/(api\.[a-z]{8}\.com|.*sdapi.*|.*kanshipin.*)\/.* script-path=https://raw.githubusercontent.com/matiaoer/Loon-Config/refs/heads/main/adclean.js,requires-body=true,max-size=0,tag=视频App去广告净化
