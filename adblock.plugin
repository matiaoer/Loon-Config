[Name]
Custom Video App AdBlock

[Description]
Author = Custom
Description = 通过脚本精准清洗视频App广告

[Rule]
DOMAIN-KEYWORD, kanshipin, REJECT
DOMAIN-KEYWORD, sdapi, REJECT

[Rewrite]
^https?:\/\/.*\/.*(splash|ad|startup|banner).*$ - REJECT

[Script]
# 核心：拦截响应体并交由本地或远程 JS 脚本处理（这里以处理开屏或数据接口为例）
http-response ^https?:\/\/(api\.[a-z]{8}\.com|.*sdapi.*)\/.* script-path=https://raw.githubusercontent.com/你的GitHub用户名/仓库名/main/adclean.js, requires-body=true, tag=App去广告净化脚本
