#!name = Custom Video App AdBlock
#!desc = 终极通杀开屏与暂停广告
#!author = Custom

[Rule]
# 1. 强力泛域名后缀拦截所有 sdapi 变体
DOMAIN-SUFFIX, 4zu76s.com, REJECT
DOMAIN-SUFFIX, re3k7n.com, REJECT
DOMAIN-SUFFIX, use3p2m.com, REJECT
DOMAIN-SUFFIX, g4k74qn.com, REJECT
DOMAIN-SUFFIX, 6ne6zmh.com, REJECT
DOMAIN-SUFFIX, tymnpk4.com, REJECT
DOMAIN-SUFFIX, u4gdp3.com, REJECT
DOMAIN-SUFFIX, kanshipinaxsdf.com, REJECT

# 2. 核心关键字全局强杀
DOMAIN-KEYWORD, sdapi, REJECT
DOMAIN-KEYWORD, kanshipin, REJECT
DOMAIN-KEYWORD, newapi, REJECT
DOMAIN-KEYWORD, 918api, REJECT
DOMAIN-KEYWORD, haiwaiapi, REJECT

[Rewrite]
# 3. 强力正则阻断所有 sdapi、newapi 以及 8 位随机 API
^https?:\/\/.*sdapi.*\/ - reject
^https?:\/\/.*newapi.*\/ - reject
^https?:\/\/api\.[a-z]{8}\.com\/ - reject

# 4. 核心拦截：精准阻断开屏、主页浮窗、评论广告，并【新增】对暂停(pause)、浮窗(float)、弹窗(pop)等接口实施空响应劫持
^https?:\/\/(?:[a-z0-9-]+\.)+[a-z]+\/App\/([Aa]d\/.*|[Ii]ndexList\/homeFloatAd|[Rr]esource\/CommentAd|.*(pause|float|pop|banner|notice|recommend|stop).*)$ - reject_dict(200)

# 5. 兜底正则
^https?:\/\/.*\/.*(splash|ad|startup|banner|notice|pause|float).*$ - reject

[MITM]
# 6. 精准解密相关动态后端，绝不碰 *.com，完美保护 Gemini
hostname = *.sdapi.*, *.kanshipin*.com, *.xqe4cxu.com, *.syq8gvw.com, *.zjypp7x.com, *.wtwvm3.com, *.jjawa.com, *.emw5es6.com
