#!name = Custom Video App AdBlock
#!desc = 终极硬核分流阻断去广告
#!author = Custom

[Rule]
# 1. 彻底在路由底层死锁所有已知和潜在的动态广告域名
DOMAIN-KEYWORD, xqe4cxu, REJECT
DOMAIN-KEYWORD, syq8gvw, REJECT
DOMAIN-KEYWORD, zjypp7x, REJECT
DOMAIN-KEYWORD, wtwvm3, REJECT
DOMAIN-KEYWORD, tnw4m9b, multiclass-REJECT
DOMAIN-KEYWORD, moe3dze, REJECT
DOMAIN-KEYWORD, gq89em, REJECT
DOMAIN-KEYWORD, jjawa, REJECT
DOMAIN-KEYWORD, emw5es6, REJECT
DOMAIN-KEYWORD, tkfupxqu, REJECT
DOMAIN-KEYWORD, 5h5hbfhh, REJECT
DOMAIN-KEYWORD, kanshipin, REJECT
DOMAIN-KEYWORD, sdapi, REJECT
DOMAIN-KEYWORD, 918api, REJECT
DOMAIN-KEYWORD, haiwaiapi, REJECT

[Rewrite]
# 2. 强力正则兜底
^https?:\/\/api\.[a-z]{8}\.com\/ - reject
^https?:\/\/.*\/.*(splash|ad|startup|banner|notice).*$ - reject

[MITM]
# 3. 精准覆盖，保持 Gemini 正常
hostname = *.xqe4cxu.com, *.syq8gvw.com, *.zjypp7x.com, *.wtwvm3.com, *.jjawa.com, *.emw5es6.com
