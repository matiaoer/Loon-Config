[Name]
Custom Video App AdBlock

[Description]
Author = Custom
Description = 终极通杀 sdapi 及看视频类App动态域名

[Rule]
# 1. 强力泛域名拦截 sdapi 系列广告后端
DOMAIN-SUFFIX, 4zu76s.com, REJECT
DOMAIN-SUFFIX, use3p2m.com, REJECT
DOMAIN-SUFFIX, g4k74qn.com, REJECT
DOMAIN-SUFFIX, 6ne6zmh.com, REJECT
DOMAIN-SUFFIX, re3k7n.com, REJECT
DOMAIN-SUFFIX, tymnpk4.com, REJECT
DOMAIN-SUFFIX, u4gdp3.com, REJECT

# 2. 关键字通杀所有包含 kanshipin 或 sdapi 的请求
DOMAIN-KEYWORD, kanshipin, REJECT
DOMAIN-KEYWORD, sdapi, REJECT
DOMAIN-KEYWORD, 918api, REJECT
DOMAIN-KEYWORD, haiwaiapi, REJECT

[Rewrite]
# 3. 正则表达式终极拦截所有带 sdapi 或 kanshipin 的网址
^https?:\/\/.*sdapi.*\/ - REJECT
^https?:\/\/.*kanshipin.*\/ - REJECT
^https?:\/\/.*\/.*(splash|ad|startup|banner|notice).*$ - REJECT

[Script]
