[Name]
Custom Video App AdBlock

[Description]
Author = Custom
Description = 强力通杀动态随机域名及广告接口

[Rule]
# 1. 关键字通杀所有带 -api 的动态后端
DOMAIN-KEYWORD, -api, REJECT

# 2. 匹配并拒绝之前出现过的广告及随机域名特征
DOMAIN-KEYWORD, 583-api, REJECT
DOMAIN-KEYWORD, 7449770, REJECT
DOMAIN-KEYWORD, 32493108, REJECT
DOMAIN-KEYWORD, minordongzuo, REJECT
DOMAIN-KEYWORD, kanshipin, REJECT
DOMAIN-KEYWORD, tkfupxqu, REJECT
DOMAIN-KEYWORD, 918api, REJECT
DOMAIN-KEYWORD, haiwaiapi, REJECT

[Rewrite]
# 3. 正则表达式通杀所有包含 api 且夹杂随机字符的 URL
^https?:\/\/.*-api.*\/ - REJECT
^https?:\/\/.*\/.*(splash|ad|startup|banner|notice).*$ - REJECT

[Script]
